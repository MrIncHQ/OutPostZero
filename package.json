{
  "name": "outpost-zero",
  "version": "0.15.3",
  "private": true,
  "description": "Portable offline knowledge, tools, and communication platform",
  "main": "dist/main/main/main.js",
  "author": "Outpost Zero",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env OUTPOST_ZERO_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.main.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "verify": "npm run test && npm run build",
    "package:win": "npm run verify && electron-builder --win dir",
    "release:win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Build-PortableWindows.ps1",
    "audit:update-distribution": "node scripts/verify-update-distribution.mjs Releases/GitHubDistribution ReleaseSigning/public.pem --git-index"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.6",
    "@fontsource-variable/newsreader": "^5.2.6",
    "@napi-rs/canvas": "^1.0.5",
    "@protomaps/basemaps": "^5.7.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "maplibre-gl": "^6.2.0",
    "pdfjs-dist": "^6.2.108",
    "pmtiles": "^4.4.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "selfsigned": "^3.0.1",
    "serialport": "^13.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.1",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "local.outpostzero.app",
    "productName": "Outpost Zero",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "node_modules/@napi-rs/canvas/**/*",
      "node_modules/@napi-rs/canvas-win32-x64-msvc/**/*",
      "node_modules/tesseract.js/**/*",
      "node_modules/tesseract.js-core/**/*",
      "node_modules/@tesseract.js-data/eng/**/*",
      "node_modules/@serialport/bindings-cpp/prebuilds/win32-x64/*.node"
    ],
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/**/*",
      "vendor/map-assets/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": ".outpost-zero-root",
        "to": ".outpost-zero-root"
      },
      {
        "from": "portable/README.txt",
        "to": "README.txt"
      },
      {
        "from": "portable/REMOTE_ID_RECEIVER.txt",
        "to": "resources/REMOTE_ID_RECEIVER.txt"
      },
      {
        "from": "portable/Run_Outpost_Zero.bat",
        "to": "Run_Outpost_Zero.bat"
      },
      {
        "from": "portable/PortableUpdater.ps1",
        "to": "PortableUpdater.ps1"
      },
      {
        "from": "portable/Extract_Kiwix.ps1",
        "to": "resources/Extract_Kiwix.ps1"
      },
      {
        "from": "portable/UpdaterBootstrap.ps1",
        "to": "resources/UpdaterBootstrap.ps1"
      },
      {
        "from": "vendor/pmtiles/pmtiles.exe",
        "to": "resources/pmtiles/pmtiles.exe"
      },
      {
        "from": "vendor/pmtiles/LICENSE",
        "to": "resources/pmtiles/LICENSE"
      },
      {
        "from": "vendor/map-assets/Noto-Sans-OFL.txt",
        "to": "resources/map-assets/Noto-Sans-OFL.txt"
      },
      {
        "from": "vendor/map-assets/Protomaps-BSD-3-Clause.md",
        "to": "resources/map-assets/Protomaps-BSD-3-Clause.md"
      },
      {
        "from": "vendor/medication-data",
        "to": "resources/medication-data"
      }
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
